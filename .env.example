# =============================================================================
# SCOLAIRA — Environment Variables (example)
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# All .env*.local files are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Canonical public URL of the deployed application (school console).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical public URL for parent payment pages. Same origin during pilot.
NEXT_PUBLIC_PAY_URL=http://localhost:3000

# Application environment: development | staging | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — configured in M2; placeholders only in M0
# -----------------------------------------------------------------------------
# Postgres connection string used by Drizzle / server-side DB client.
# Example for local dev: postgresql://scolaira:scolaira@localhost:5432/scolaira
DATABASE_URL=postgresql://localhost:5432/scolaira

# Separate direct connection string for migrations (if needed) — typically same URL.
DATABASE_MIGRATION_URL=postgresql://localhost:5432/scolaira

# -----------------------------------------------------------------------------
# Supabase (Auth / Storage) — configured in M3
# -----------------------------------------------------------------------------
# Supabase project URL and anon/public key (safe to expose to client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Paystack (online payments) — configured in Phase 2
# -----------------------------------------------------------------------------
# Public key is safe in the client; secret key is server-only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend) — configured when receipts/reset emails are implemented
# -----------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL_ADDRESS=

# -----------------------------------------------------------------------------
# Error tracking / observability — configured when deploying to staging
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Runtime secrets
# -----------------------------------------------------------------------------
# A 32+ byte random secret used for any additional session / CSRF signing
# that sits outside Supabase auth (generate with: openssl rand -base64 32).
SCOLAIRA_SESSION_SECRET=
