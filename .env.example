# =============================================================================
# SCOLAIRA — Environment Variables (example / contract)
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# All .env*.local files are gitignored.
#
# This file states what the RUNNING BUILD actually reads. Anything a document
# promises but no code reads is marked as such below, so an operator cannot set
# a variable that looks required and silently do nothing.
#
#   §1 REQUIRED to serve traffic   — without these, /api/ready returns 503
#   §2 OPTIONAL / operational       — defaults are safe; set deliberately
#   §3 DEVELOPMENT ONLY             — never set in a deployed environment
#   §4 DECLARED, NOT READ           — no implementation exists in this build
# =============================================================================

# -----------------------------------------------------------------------------
# §1 REQUIRED to serve traffic
# -----------------------------------------------------------------------------

# Postgres connection string used by the application at runtime.
# MUST use the least-privileged runtime role (`scolaira_app`), never the owner.
# A `ready` deployment proves this connection works (GET /api/ready).
DATABASE_URL=postgresql://scolaira_app:scolaira_app_pw@localhost:5432/scolaira

# Postgres connection string for the schema OWNER role. Used by migrations,
# restore verification and provisioning tools — never by the request path.
DATABASE_MIGRATION_URL=postgresql://scolaira_owner:scolaira_owner_pw@localhost:5432/scolaira

# Session/cookie signing secret, 32+ bytes (generate: openssl rand -base64 32).
# Presence is not usability: a short or malformed value makes /api/ready fail
# closed with `auth:auth_unconfigured`, and the startup log line say so.
SCOLAIRA_SESSION_SECRET=

# Application environment: development | test | production
NODE_ENV=development

# Canonical public URL of the deployed application (school console).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# §2 OPTIONAL / operational
# -----------------------------------------------------------------------------

# Previous session secret, accepted during key rotation so existing sessions
# survive a secret change. Remove once the old sessions have expired.
SCOLAIRA_SESSION_SECRET_PREVIOUS=

# Database pool ceiling per process. Isolation does not depend on this value
# (requests reserve a connection for their lifetime); it is a resource cap.
SCOLAIRA_DB_POOL_MAX=

# Build identity, surfaced by /api/health, /api/ready and the startup log line.
# Managed hosts usually supply an equivalent automatically (e.g. a git SHA).
SCOLAIRA_BUILD_COMMIT=

# Number of trusted proxy hops in front of the app, for client-IP resolution.
# Set this to the real topology when deployed behind a proxy/CDN; leaving it
# unset trusts nothing, which is the safe default and the wrong answer if a
# proxy exists.
TRUSTED_PROXY_HOPS=

# Parent payment base URL. Accepted and validated by the environment module;
# no feature reads it yet (same origin during pilot).
NEXT_PUBLIC_PAY_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# §3 DEVELOPMENT ONLY — never set in a deployed environment
# -----------------------------------------------------------------------------

# Runs the runtime database pool on the MIGRATION (owner) credential. This
# exists for bootstrap and tests only: with it set, the request path is no
# longer running as the least-privileged role. Asserted by the runtime-role
# safety test; must be `1` or unset, and unset in production.
# SCOLAIRA_BOOTSTRAP=1

# Echoes password-reset tokens in API responses for local testing. Never set
# outside development.
# SCOLAIRA_DEV_ECHO_RESET_TOKEN=1

# -----------------------------------------------------------------------------
# §4 DECLARED, NOT READ BY THIS BUILD
#
# These names exist in `lib/security/env.ts` as accessors with no consumer, and
# no feature in this repository calls the corresponding provider. They are kept
# only so the shape of a future integration is visible. A production operator
# does NOT need to set any of them, and setting one has no effect.
#
# Authentication is implemented in-repo (session cookies + CSRF), not Supabase.
# Payments are recorded manually; no payment-provider API call exists.
# Email and error reporting are not integrated; the operational signal today is
# the structured JSON log lines.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
RESEND_API_KEY=
FROM_EMAIL_ADDRESS=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Internal origin ────────────────────────────────────────────────────────────
# Where the server calls its OWN JSON API for server-side page data.
#
# Unset (default): derived from the inbound request (x-forwarded-proto + host).
#   Correct behind a publicly-trusted certificate; FAILS behind a self-signed one
#   (`DEPTH_ZERO_SELF_SIGNED_CERT`), because the round-trip re-enters through TLS.
#
# Set it to the app's own address to keep the round-trip on the host and remove the
# certificate from the path entirely — recommended for staging, previews and any
# environment whose TLS terminator is not publicly trusted:
#
#   SCOLAIRA_INTERNAL_ORIGIN=http://127.0.0.1:3000
#
# This does not disable TLS verification and does not bypass any authorization:
# the session cookie is still forwarded and the route still enforces session,
# tenant, role and RLS.
SCOLAIRA_INTERNAL_ORIGIN=
