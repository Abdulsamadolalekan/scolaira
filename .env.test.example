# Copy to .env.test for local vitest runs
DATABASE_URL=postgresql://scolaira:scolaira@localhost:5432/scolaira_test
# Session secret MUST be at least 32 bytes for HMAC-SHA256 cookie signing.
SCOLAIRA_SESSION_SECRET=test-session-secret-please-use-openssl-rand-48-bytes-minimum-for-real-env
# DO NOT set in production. When BOTH this flag is "1" AND NODE_ENV !== "production",
# the reset-request endpoint echoes the plaintext token for E2E testing. Default is
# safe: token: null. Tests that need the token set SCOLAIRA_DEV_ECHO_RESET_TOKEN=1.
SCOLAIRA_DEV_ECHO_RESET_TOKEN=1
